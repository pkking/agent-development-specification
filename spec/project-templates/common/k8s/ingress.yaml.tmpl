# K8s Ingress 模板 — <<PROJECT_NAME>>
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: <<PROJECT_NAME>>
  namespace: <<NAMESPACE>>
  annotations:
    kubernetes.io/ingress.class: nginx
    nginx.ingress.kubernetes.io/rewrite-target: /
spec:
  rules:
    - host: <<PROJECT_NAME>>.<<BASE_DOMAIN>>
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: <<PROJECT_NAME>>
                port:
                  number: 80
