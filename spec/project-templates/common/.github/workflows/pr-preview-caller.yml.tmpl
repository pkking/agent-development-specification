# PR 预览 caller — A 档接入仅此一个 workflow
# 复制到 <<PROJECT_NAME>>/.github/workflows/pr-preview-caller.yml

name: <<PROJECT_NAME>> PR Preview

on:
  pull_request:
    types: [opened, synchronize, reopened, closed]

permissions:
  pull-requests: write
  contents: read

jobs:
  preview:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Dispatch preview to k8s-deployer
        uses: peter-evans/repository-dispatch@v3
        with:
          token: ${{ secrets.DISPATCH_TOKEN }}
          repository: <generic-layer-org>/<generic-layer-repo>
          event-type: pr-preview
          client-payload: |
            {
              "project": "<<PROJECT_NAME>>",
              "namespace": "<<NAMESPACE>>",
              "base_domain": "<<BASE_DOMAIN>>",
              "pr_number": "${{ github.event.pull_request.number }}",
              "pr_action": "${{ github.event.action }}",
              "sha": "${{ github.event.pull_request.head.sha }}"
            }
